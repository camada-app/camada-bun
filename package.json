{
  "name": "@camada/bun",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "description": "camada SDK for Bun.serve: snapshot enforcement, first-party challenge and beacon, track() outcomes, the socket peer from server.requestIP, timer-polled snapshot with exit flush",
  "homepage": "https://www.camada.app/frameworks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camada-app/camada-bun.git"
  },
  "bugs": {
    "url": "https://github.com/camada-app/camada-bun/issues"
  },
  "keywords": [
    "camada",
    "bun",
    "typescript",
    "http-server",
    "bot-detection",
    "bot-protection",
    "credential-stuffing",
    "account-takeover",
    "rate-limiting",
    "proof-of-work",
    "ai-scraper",
    "security"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@camada/core": "file:../camada-core",
    "@camada/browser": "file:../camada-browser"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
